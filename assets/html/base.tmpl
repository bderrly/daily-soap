{{define "base"}}
<!doctype html>
<html lang='en'>
    <head>
        <meta charset='utf-8'>
        <title>{{template "page:title" .}}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta
            name="htmx-config"
            content='{
                "includeIndicatorStyles": false,
                "historyCacheSize": 0,
                "historyRestoreAsHxRequest": false,
                "disableInheritance": true,
                "responseHandling":[
                    {"code":"204", "swap": false},
                    {"code":"422", "swap": true},
                    {"code":"[45]..", "swap": true, "target": "body"},
                    {"code":"...", "swap": true}
                ]
            }'
        >

        <link rel="icon" type="image/png" href="/static/images/favicon.png">
        <link rel="stylesheet" href="/static/css/flatpickr.min.css">
        <link rel="stylesheet" href="/static/css/mysoaps.css">
        {{if .CustomStylesheet}}
        <link rel="stylesheet" href="/static/css/{{.CustomStylesheet}}">
        {{end}}
        <script defer src="/static/js/flatpickr.min.js" nonce="{{.Nonce}}"></script>
        <script defer src="/static/js/htmx.min.js" nonce="{{.Nonce}}"></script>
        <script defer src="/static/js/fumsV3.min.js" nonce="{{.Nonce}}"></script>
        <script nonce="{{.Nonce}}">
            window.fumsData = window.fumsData || [];
            window.fums = window.fums || function () {
                window.fumsData.push(arguments);
            };
            {{if .user}}
            window.fums("config", { userId: "{{.user.ID}}" });
            {{end}}
        </script>
        <script type="module" src="/static/js/app.js" nonce="{{.Nonce}}"></script>
    </head>
    <body>
        <div class="container">
            {{template "partial:header_nav" .}}
            <main>
                {{template "page:content" .}}
            </main>
            {{template "partial:footer" .}}
        </div>
    </body>
</html>
{{end}}
